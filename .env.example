PORT=5000
FRONTEND_URL=http://localhost:5173
# Set true when the frontend and API use different production domains
# (for example Vercel + Render/Railway). Requires HTTPS on both sides.
# CROSS_ORIGIN_COOKIES=false
# Public HTTPS origin used in the generated Shadowrocket config URL.
# PUBLIC_ORIGIN=https://your-domain.example
# Optional overrides for Locket's public mobile-client configuration.
# This must be Locket's Firebase project key, not a key from your own project.
# LOCKET_FIREBASE_API_KEY=
# LOCKET_STORAGE_BUCKET=locket-img
# Optional: a legitimately issued App Check token, if required by upstream.
# The server does not generate or bypass App Check verification.
# LOCKET_APPCHECK_TOKEN=
# Set NODE_ENV=production only behind HTTPS. Serve /api on the frontend origin.
